# Copy this file to backend/.env and adjust as needed. backend/.env is
# gitignored and never committed -- this .example file is the only one
# tracked in git.
#
# backend/main.py loads backend/.env automatically at startup
# (python-dotenv). A variable already set in your real shell environment
# always takes priority over the .env file.

# ---------------------------------------------------------------------------
# GenAI Explanation Agent (Phase 8C/8D + Groq integration) --
# backend/agents/genai_explanation.py
#
# Provider chain: GroqCloud (primary) -> Ollama (secondary fallback) ->
# deterministic template explanation (final, always-available fallback).
# Every provider's output passes through the SAME safety/consistency
# validation before it is ever returned -- see genai_explanation.py.
# ---------------------------------------------------------------------------

# Master switch. When "false" (the safe default), /uc07/explain always
# returns the deterministic fallback immediately and no LLM provider is
# ever contacted -- the rest of the app is fully functional either way.
GENAI_ENABLED=true

# Which provider is PRIMARY: "groq" (default) tries GroqCloud first, then
# falls back to Ollama, then to the deterministic explanation. "ollama"
# skips Groq entirely and matches this app's pre-Groq behavior exactly.
GENAI_PROVIDER=groq

# Your GroqCloud API key (https://console.groq.com/keys). Leave blank to
# skip Groq entirely (falls straight through to Ollama/deterministic) --
# a blank key never causes an error, just an immediate fallback.
GROQ_API_KEY=

# Model id as currently listed at https://console.groq.com/docs/models.
# Groq's supported model lineup changes over time -- verify this is still
# a valid, enabled model for your account before relying on it.
GROQ_MODEL=openai/gpt-oss-20b

# Request timeout in seconds, shared by both Groq and Ollama calls. Any
# timeout just falls through to the next provider in the chain, never an
# error response.
GENAI_TIMEOUT_SECONDS=30

# Local Ollama HTTP API base URL (fallback provider).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model name as known to your local Ollama install (`ollama list`).
OLLAMA_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# CORS (Phase 8D Part 11) -- backend/main.py
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins. Unset defaults to the
# local Vite dev server addresses, so this only needs to be set if your
# frontend runs somewhere else.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
