# Copy this file to backend/.env and adjust as needed. backend/.env is
# gitignored and never committed -- this .example file is the only one
# tracked in git.
#
# backend/main.py loads backend/.env automatically at startup
# (python-dotenv). A variable already set in your real shell environment
# always takes priority over the .env file.

# ---------------------------------------------------------------------------
# GenAI Explanation Agent (Phase 8C/8D) -- backend/agents/genai_explanation.py
# ---------------------------------------------------------------------------

# Master switch. When "false" (the safe default), /uc07/explain always
# returns the deterministic fallback immediately and Ollama is never
# contacted -- the rest of the app is fully functional either way.
GENAI_ENABLED=false

# Local Ollama HTTP API base URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model name as known to your local Ollama install (`ollama list`).
OLLAMA_MODEL=qwen3:8b

# Request timeout in seconds. Ollama's first call after an idle period
# can take significantly longer than a warm call (model load into
# memory) -- set this generously (e.g. 60) rather than tight, since any
# timeout just falls back to the deterministic explanation, never an error.
GENAI_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# CORS (Phase 8D Part 11) -- backend/main.py
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins. Unset defaults to the
# local Vite dev server addresses, so this only needs to be set if your
# frontend runs somewhere else.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
